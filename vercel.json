{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "functions/api/*.ts": {
      "maxDuration": 10,
      "runtime": "@vercel/node@22.8.0"
    },
    "functions/redirect.ts": {
      "maxDuration": 10,
      "runtime": "@vercel/node@22.8.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/functions/api/:path*.ts"
    },
    {
      "source": "/:path*",
      "destination": "/functions/redirect.ts"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}